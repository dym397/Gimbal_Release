[Unit]
Description=Gimbal Tracking Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linaro
Group=linaro
SupplementaryGroups=dialout
WorkingDirectory=/home/linaro/gimbal_release
Environment=RID_SORT_ALIGNMENT_ENABLE=0
Environment=RID_SORT_ALIGNMENT_PRINT_INTERVAL=10
Environment=RID_SORT_ALIGNMENT_PAIR_MODE=learned
Environment=PRINT_LIVE_STATUS=0
Environment=GIMBAL_CAMERA_SOURCE=/dev/v4l/by-path/platform-xhci-hcd.4.auto-usb-0:1.1:1.0-video-index0
Environment=GIMBAL_PORT=/dev/serial/by-path/platform-xhci-hcd.4.auto-usb-0:1.2.2:1.0-port0
Environment=LASER_PORT=/dev/serial/by-path/platform-xhci-hcd.4.auto-usb-0:1.4:1.0-port0
Environment=GPS_PORT=/dev/serial/by-path/platform-xhci-hcd.4.auto-usb-0:1.2.1:1.0-port0
Environment=RID_PORT=/dev/serial/by-path/platform-xhci-hcd.4.auto-usb-0:1.2.3:1.0-port0
EnvironmentFile=-/etc/default/gimbal-tracking
ExecStart=/home/linaro/gimbal_release/run_main_tracking.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
